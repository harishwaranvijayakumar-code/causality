# Local development only. Replace the secret before deployment.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty to use local SQLite.
# For PostgreSQL, supply a valid connection URL.
DATABASE_URL=

# Base URL of the Jaeger Query service reachable by the backend.
# Local example only. Set the hosted value in the hosting provider's environment.
JAEGER_QUERY_URL=http://localhost:16686
